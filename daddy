  <div class="space-buffer" aria-hidden="true">&nbsp;</div>

  <script>
    // floating sparks
    const body = document.body;
    for (let i = 0; i < 18; i++) {
      const s = document.createElement('div');
      s.className = 'spark';
      const size = Math.random() * 3 + 1.5;
      s.style.width = size + 'px';
      s.style.height = size + 'px';
      s.style.left = Math.random() * 100 + 'vw';
      s.style.animationDuration = (10 + Math.random() * 10) + 's';
      s.style.animationDelay = (Math.random() * 14) + 's';
      body.appendChild(s);
    }

    // Countdown target: 01/10/2026 (1 Oct 2026), local time midnight
    const target = new Date('2026-10-01T00:00:00');

    const daysEl = document.getElementById('days');
    const daysLabelEl = document.getElementById('daysLabel');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');
    const timerBox = document.getElementById('timerBox');
    const revealedBox = document.getElementById('revealedBox');
    const faqSection = document.getElementById('faqSection');
    const loveNote = document.getElementById('loveNote');
    const revealPopupOverlay = document.getElementById('revealPopupOverlay');
    const seeWhoBtn = document.getElementById('seeWhoBtn');

    // Step 1: timer ends -> hide timer, show "timer has ended" popup
    function reveal() {
      timerBox.style.display = 'none';
      revealPopupOverlay.classList.add('open');
    }

    // Step 2: user clicks "See who i'm" -> close popup, show the image reveal
    function showFinalReveal() {
      revealPopupOverlay.classList.remove('open');
      revealedBox.style.display = 'block';
      faqSection.style.display = 'none';
      loveNote.style.display = 'block';
      initCarousel();
    }

    seeWhoBtn.addEventListener('click', showFinalReveal);

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
      const now = new Date();
      const diff = target - now;

      if (diff <= 0) {
        reveal();
        clearInterval(intervalId);
        return;
      }

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const m = Math.floor((diff / (1000 * 60)) % 60);
      const s = Math.floor((diff / 1000) % 60);

      daysEl.textContent = pad(d);
      daysLabelEl.textContent = d === 1 ? 'day' : 'days';
      hoursEl.textContent = pad(h);
      minutesEl.textContent = pad(m);
      secondsEl.textContent = pad(s);
    }

    tick();
    const intervalId = setInterval(tick, 1000);

    // Skip timer button — opens the code entry modal
    const skipBtn = document.getElementById('skipBtn');
    const codeOverlay = document.getElementById('codeOverlay');
    const codeClose = document.getElementById('codeClose');
    const codeDots = document.getElementById('codeDots');
    const codeMsg = document.getElementById('codeMsg');
    const dotSlots = codeDots.querySelectorAll('.dot-slot');
    const codeKeys = document.querySelectorAll('.code-key[data-key]');
    const SKIP_CODE = '9199';
    let enteredCode = '';

    function renderDots() {
      dotSlots.forEach((slot, i) => {
        slot.classList.toggle('filled', i < enteredCode.length);
      });
    }

    function resetCode() {
      enteredCode = '';
      codeMsg.textContent = '';
      codeDots.classList.remove('shake');
      renderDots();
    }

    function openCodeModal() {
      resetCode();
      codeOverlay.classList.add('open');
    }

    function closeCodeModal() {
      codeOverlay.classList.remove('open');
      resetCode();
    }

    skipBtn.addEventListener('click', openCodeModal);
    codeClose.addEventListener('click', closeCodeModal);
    codeOverlay.addEventListener('click', (e) => {
      if (e.target === codeOverlay) closeCodeModal();
    });

    codeKeys.forEach((key) => {
      key.addEventListener('click', () => {
        const value = key.dataset.key;

        if (value === 'back') {
          enteredCode = enteredCode.slice(0, -1);
          codeMsg.textContent = '';
          codeDots.classList.remove('shake');
          renderDots();
          return;
        }

        if (enteredCode.length >= 4) return;

        enteredCode += value;
        renderDots();

        if (enteredCode.length === 4) {
          if (enteredCode === SKIP_CODE) {
            codeMsg.style.color = 'var(--violet-bright)';
            codeMsg.textContent = 'correct ✦';
            setTimeout(() => {
              codeOverlay.classList.remove('open');
              clearInterval(intervalId);
              reveal();
              resetCode();
            }, 350);
          } else {
            codeMsg.style.color = 'var(--ember)';
            codeMsg.textContent = 'wrong code, try again';
            codeDots.classList.add('shake');
            setTimeout(() => {
              enteredCode = '';
              codeDots.classList.remove('shake');
              renderDots();
            }, 450);
          }
        }
      });
    });

    // ===== Image Carousel (5 images, next/prev + swipe) =====
    const carouselImgs = document.querySelectorAll('.carousel-img');
    const carouselDots = document.querySelectorAll('.carousel-dots .cdot');
    const prevImgBtn = document.getElementById('prevImgBtn');
    const nextImgBtn = document.getElementById('nextImgBtn');
    const carouselInner = document.getElementById('carouselInner');
    let currentImg = 0;
    let carouselInitialized = false;

    function goToImg(index) {
      const total = carouselImgs.length;
      currentImg = (index + total) % total;
      carouselImgs.forEach((img, i) => img.classList.toggle('active', i === currentImg));
      carouselDots.forEach((dot, i) => dot.classList.toggle('active', i === currentImg));
    }

    function initCarousel() {
      if (carouselInitialized) return;
      carouselInitialized = true;
      goToImg(0);
    }

    prevImgBtn.addEventListener('click', () => goToImg(currentImg - 1));
    nextImgBtn.addEventListener('click', () => goToImg(currentImg + 1));

    carouselDots.forEach((dot) => {
      dot.addEventListener('click', () => goToImg(parseInt(dot.dataset.index, 10)));
    });

    // swipe support (touch)
    let touchStartX = 0;
    let touchEndX = 0;

    carouselInner.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    carouselInner.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) goToImg(currentImg + 1); // swipe left -> next
        else goToImg(currentImg - 1); // swipe right -> prev
      }
    }, { passive: true });

    // FAQ accordion — only one open at a time
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach((item) => {
      const question = item.querySelector('.faq-question');
      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        faqItems.forEach((i) => i.classList.remove('open'));
        if (!isOpen) {
          item.classList.add('open');
        }
      });
    });
  </script>

</body>
